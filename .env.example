# 默认无需配置：使用 data/exam_engine.db。
# PostgreSQL 示例（仅开发环境）：
# DATABASE_URL=postgresql+psycopg://exam_engine:exam_engine@127.0.0.1:5432/exam_engine

# 默认使用明确标注的 Mock，不消耗真实模型额度；仅用于流程检查。
MODEL_PROVIDER=mock

# 使用真实 API 时，将上面的 MODEL_PROVIDER 改成 openai-compatible，
# 再取消下面三行的注释并填写服务商给出的值；不要提交真实密钥。
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=replace-with-an-available-model-id
# BASE_URL 是 API 根地址，不附加 /chat/completions；模型需支持 JSON 输出。
# 图片/扫描件还需模型支持图片输入；修改后重启 npm run dev。

# 本地测试默认不限流，旧的正数预算值也不会自动生效。
# 仅在确实需要硬预算时，同时开启开关并设置正数；每次调用先预留 token，超限拒绝新调用。
# MODEL_ENFORCE_TOKEN_BUDGET=true
# MODEL_COURSE_TOKEN_BUDGET=20000
# MODEL_DAILY_TOKEN_BUDGET=200000

# 可选成本估算，单位是美元 / 百万 token；请按实际 provider 价格填写。
# MODEL_INPUT_USD_PER_MILLION=0
# MODEL_OUTPUT_USD_PER_MILLION=0
